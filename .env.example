# Copia este archivo a .env. `npm run dev` usa el Supabase demo (desing-clothes, esquema mikuy):
# no hay Supabase local. Estos dos valores son públicos.
VITE_SUPABASE_URL=https://exxcgaikbjfojpfpiocj.supabase.co
# La publishable key (sb_publishable_...). Nunca la secret ni la service_role.
VITE_SUPABASE_ANON_KEY=sb_publishable_rLXuT0g0aglC2RmiYpQE-Q_eYx-iNAC

# El build que se despliega usa .env.production (está en el repo, solo con valores públicos).

# Solo para `npm run db:push:demo`: session pooler del Supabase demo.
# Es secreta: vive solo en .env, nunca se imprime ni se copia a otro archivo.
# DATABASE_URL=postgresql://postgres.exxcgaikbjfojpfpiocj:<contraseña>@<host>.pooler.supabase.com:5432/postgres

# Observabilidad: solo se activa en el build de producción. En desarrollo pueden quedar vacías.
VITE_GLITCHTIP_DSN=
VITE_UMAMI_WEBSITE_ID=

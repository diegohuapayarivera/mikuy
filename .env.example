# Copia este archivo a .env. Así como está apunta al Supabase local (npm run db:start).
# Estas claves son las de ejemplo del Supabase local: públicas e iguales en toda máquina.
# `npx supabase status` las muestra.
VITE_SUPABASE_URL=http://127.0.0.1:54321
# La publishable key (sb_publishable_...) o la anon key. Nunca la secret ni la service_role.
VITE_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Para el deploy, crea .env.production con los valores de la nube (Vite lo usa en `npm run build`).

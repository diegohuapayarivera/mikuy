{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mikuy",
  "compatibility_date": "2026-10-23",
  // Solo assets estáticos: no hay código de servidor (la lógica vive en Postgres).
  "assets": {
    "directory": "./dist",
    // Las rutas desconocidas devuelven index.html y el front las resuelve.
    "not_found_handling": "single-page-application",
  },
  // Dominio de producción, en la zona nrlsys.com. Cuando se compre mikuy.dev, cámbialo aquí (y ver
  // la sección Dominio de CLAUDE.md).
  "routes": [{ "pattern": "mikuy.nrlsys.com", "custom_domain": true }],
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mikuy",
  "compatibility_date": "2026-10-23",
  // Solo assets estáticos: no hay código de servidor (la lógica vive en Postgres).
  "assets": {
    "directory": "./dist",
    // Las rutas desconocidas devuelven index.html y el front las resuelve.
    "not_found_handling": "single-page-application",
  },
  // Dominio propio: descomenta cuando mikuy.dev esté en tu cuenta de Cloudflare.
  // "routes": [{ "pattern": "mikuy.dev", "custom_domain": true }],
}
